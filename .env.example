# PostgreSQL Database Connection URL
# Examples:
# Local PostgreSQL: postgresql://postgres:password@localhost:5432/bellum_db
# Supabase / Neon: postgresql://user:password@ep-xyz.region.aws.neon.tech/bellum_db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bellum_db

# Optional direct connection parameters if not using DATABASE_URL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=bellum_db
